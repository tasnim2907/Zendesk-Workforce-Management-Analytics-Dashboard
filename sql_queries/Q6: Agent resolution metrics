-- Agent efficiency metrics
SELECT 
  agent_name,
  COUNT(*) as total_assigned,
  COUNTIF(status = 'solved') as tickets_solved,
  ROUND(COUNTIF(status = 'solved') / COUNT(*) * 100, 2) as resolution_rate,
  ROUND(AVG(resolution_time_hours), 2) as avg_resolution_time,
  ROUND(AVG(first_response_time_hours), 2) as avg_first_response_time
FROM `zendesk-wfm-analytics.zendesk_support.tickets`
GROUP BY agent_name
ORDER BY resolution_rate DESC
